generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TrackModel {
  id        String          @id @default(uuid())
  title     String
  link      String
  author    String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  type      String?
  tags      String[]        @default([])
  playlists PlaylistModel[] @relation("PlaylistModelToTrackModel")

  folder   FolderModel? @relation(fields: [folderId], references: [id])
  folderId String?

  @@index([title])
  @@map("tracks")
}

model PlaylistModel {
  id        String       @id @default(uuid())
  title     String
  author    String
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  type      String?
  isPublic  Boolean?
  userId    String?
  tags      String[]     @default([])
  tracks    TrackModel[] @relation("PlaylistModelToTrackModel")

  folder   FolderModel? @relation(fields: [folderId], references: [id])
  folderId String?

  @@index([title])
  @@map("playlists")
}

model FolderModel {
  id        String   @id @default(uuid())
  name      String
  title     String
  isPublic  Boolean
  isGlobal  Boolean
  userId    String?

  tracks    TrackModel[]
  playlists PlaylistModel[]

  @@index([name])
  @@map("folders")
}

model UserModel {
  id       String @id @default(uuid())
  email    String
  password String
  name     String

  @@index([email])
  @@map("users")
}
